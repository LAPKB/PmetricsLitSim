        "interp": "linear"
      },
      "crcl": {
        "interp": "linear"
      }
    },
    "secondary": {
      "ke": "ke = ki + ke0 * crcl",
      "v": "v = v0 * weight"
    },
    "initial_conditions": null,
    "fa": null,
    "lag": null,
    "equation": {
      "dx1": "dx[1] <- r[1] - ke * X[1] + kpc * X[2] - kcp * X[1]",
      "dx2": "dx[2] <- -kpc * X[2] + kcp * X[1]"
    },
    "out": {
      "y1": "Y[1] = X[1] / v",
      "y2": "Y[2] = X[2] / (kcp/kpc*v)"
    },
    "error": {
      "type": "proportional",
